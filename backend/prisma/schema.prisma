
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  REGISTERED
  ACTIVE
  SUSPENDED
  LOCKED
}

enum Role {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ExperienceLevel {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
}

enum SkillType {
  HARD
  SOFT
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillRequirementType {
  MANDATORY
  PREFERRED
  NICE_TO_HAVE
}

enum ApplicationStatus {
  SUBMITTED
  INTERVIEW_CONFIRMED
}

enum AIProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MatchLevel {
  LOW
  MEDIUM
  HIGH
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String      @id @db.Uuid
  email        String      @unique
  fullName     String      @map("full_name")
  phone        String?
  birthDay     DateTime?   @map("birth_day") @db.Date
  role         Role?       @default(CANDIDATE)
  passwordHash String?     @map("password_hash")
  userStatus   UserStatus? @default(REGISTERED) @map("user_status")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  notifications    Notification[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RecruiterProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @map("recruiter_user_id") @db.Uuid
  companyName String   @map("company_name")
  title       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostings JobPosting[]

  @@map("recruiter_profiles")
}

model CandidateProfile {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @unique @map("candidate_user_id") @db.Uuid
  address              String?
  linkedinUrl          String?  @map("linkedin_url")
  githubUrl            String?  @map("github_url")
  portfolioUrl         String?  @map("portfolio_url")
  desiredTitle         String?  @map("desired_title")
  professionalSummary  String?  @map("professional_summary")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           CandidateSkill[]
  educations       Education[]
  workExperiences  WorkExperience[]
  projects         Project[]
  certificates     Certificate[]
  applications     Application[]

  @@map("candidate_profiles")
}

model SkillCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  skills Skill[]

  @@map("skill_categories")
}

model Skill {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  categoryId  String?   @map("category_id") @db.Uuid
  type        SkillType @default(HARD)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  category        SkillCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  aliases         SkillAlias[]
  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]

  @@map("skills")
}

model SkillAlias {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  aliasName String   @map("alias_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, aliasName])
  @@map("skill_aliases")
}

model CandidateSkill {
  candidateProfileId String           @map("candidate_profile_id") @db.Uuid
  skillId            String           @map("skill_id") @db.Uuid
  proficiencyLevel   ProficiencyLevel @default(BEGINNER) @map("proficiency_level")
  yearsOfExperience  Decimal?         @map("years_of_experience") @db.Decimal(4, 1)
  isPrimary          Boolean?         @default(false) @map("is_primary")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateProfileId, skillId])
  @@map("candidate_skills")
}

model Education {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateProfileId String    @map("candidate_profile_id") @db.Uuid
  institutionName    String    @map("institution_name")
  degree             String?
  fieldOfStudy       String?   @map("field_of_study")
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  gpa                Decimal?  @db.Decimal(3, 2)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model WorkExperience {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateProfileId String    @map("candidate_profile_id") @db.Uuid
  companyName        String    @map("company_name")
  title              String
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  isCurrent          Boolean?  @default(false) @map("is_current")
  description        String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

model Project {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateProfileId String    @map("candidate_profile_id") @db.Uuid
  name               String
  description        String?
  role               String?
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  projectUrl         String?   @map("project_url")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Certificate {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateProfileId String    @map("candidate_profile_id") @db.Uuid
  name               String
  issuingOrganization String?  @map("issuing_organization")
  issueDate          DateTime? @map("issue_date") @db.Date
  expirationDate     DateTime? @map("expiration_date") @db.Date
  credentialId       String?   @map("credential_id")
  credentialUrl      String?   @map("credential_url")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model JobPosting {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recruiterId     String          @map("recruiter_user_id") @db.Uuid
  title           String
  description     String
  requirements    String?
  benefits        String?
  salaryMin       Int?            @map("salary_min")
  salaryMax       Int?            @map("salary_max")
  currency        String?         @default("VND")
  location        String?
  employmentType  EmploymentType  @default(FULL_TIME) @map("employment_type")
  experienceLevel ExperienceLevel @default(FRESHER) @map("experience_level")
  status          JobStatus       @default(DRAFT)
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz(6)
  closedAt        DateTime?       @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  recruiterProfile RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Restrict)
  jobSkills        JobSkill[]
  applications     Application[]

  @@map("job_postings")
}

model JobSkill {
  jobId            String               @map("job_id") @db.Uuid
  skillId          String               @map("skill_id") @db.Uuid
  requirementType  SkillRequirementType @default(MANDATORY) @map("requirement_type")
  minimumYears     Decimal?             @map("minimum_years") @db.Decimal(4, 1)
  weight           Int?                 @default(1)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  jobPosting JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model Application {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId              String             @map("job_id") @db.Uuid
  candidateProfileId String             @map("candidate_profile_id") @db.Uuid
  applicationStatus  ApplicationStatus? @default(SUBMITTED) @map("application_status")
  aiProcessingStatus AIProcessingStatus? @default(PENDING) @map("ai_processing_status")
  profileSnapshot    Json               @map("profile_snapshot")
  submittedAt        DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobPosting       JobPosting       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  aiEvaluations    AiEvaluation[]

  @@unique([jobId, candidateProfileId])
  @@map("applications")
}

model AiEvaluation {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId         String     @map("application_id") @db.Uuid
  overallScore          Decimal    @map("overall_score") @db.Decimal(5, 2)
  matchLevel            MatchLevel @default(LOW) @map("match_level")
  skillsScore           Decimal?   @map("skills_score") @db.Decimal(5, 2)
  experienceScore       Decimal?   @map("experience_score") @db.Decimal(5, 2)
  educationScore        Decimal?   @map("education_score") @db.Decimal(5, 2)
  projectScore          Decimal?   @map("project_score") @db.Decimal(5, 2)
  strengths             Json?
  gaps                  Json?
  missingRequiredSkills Json?      @map("missing_required_skills")
  aiSummary             String?    @map("ai_summary")
  weightsSnapshot       Json?      @map("weights_snapshot")
  embeddingModel        String?    @map("embedding_model")
  modelVersion          String     @map("model_version")
  confidenceScore       Decimal?   @map("confidence_score") @db.Decimal(5, 2)
  processingTimeMs      Int?       @map("processing_time_ms")
  processedAt           DateTime   @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("ai_evaluations")
}

model Notification {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId String   @map("recipient_user_id") @db.Uuid
  title           String
  content         String
  type            String?
  status          String?  @default("UNREAD")
  actionUrl       String?  @map("action_url")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)

  user User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
