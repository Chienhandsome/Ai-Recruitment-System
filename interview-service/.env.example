# Leave empty to run with the deterministic fallback question generator.
GEMINI_API_KEY=
INTERVIEW_LLM_MODEL=gemini-2.5-flash-lite
INTERVIEW_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174,http://localhost:3000,http://127.0.0.1:3000
INTERVIEW_VIDEO_MAX_BYTES=52428800
# Supabase is used when both values below are supplied. Keep the service-role
# key on the Interview Service only; never expose it to Candidate Web.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public project key used only for Supabase Auth OTP HTTP endpoints.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_INTERVIEW_BUCKET=interview-videos
# Local-only fallback when Supabase credentials are not configured.
INTERVIEW_VIDEO_STORAGE_PATH=private-media
INTERVIEW_DATABASE_PATH=data/interviews.sqlite3
INTERVIEW_SYSTEM_API_KEY=dev-interview-system-key
INTERVIEW_WEB_ORIGIN=http://127.0.0.1:4174
INTERVIEW_LAUNCH_TOKEN_SECRET=replace-before-production
INTERVIEW_ACCESS_TOKEN_SECRET=replace-before-production
INTERVIEW_OTP_SECRET=replace-before-production
# Use supabase_auth on Render Free because outbound SMTP ports are blocked.
# smtp remains available for paid/self-hosted deployments; console is local-only.
INTERVIEW_OTP_PROVIDER=supabase_auth
# Shared only between Interview Service and Recruitment System. Callback body is
# signed as HMAC-SHA256("<unix_timestamp>.<raw_json_body>").
INTERVIEW_CALLBACK_SECRET=replace-before-production
INTERVIEW_CALLBACK_ALLOWED_HOSTS=localhost
INTERVIEW_ALLOW_INSECURE_CALLBACKS=false
INTERVIEW_CALLBACK_MAX_ATTEMPTS=8
INTERVIEW_CALLBACK_TIMEOUT_SECONDS=60
INTERVIEW_CALLBACK_MEDIA_GRACE_SECONDS=60
# Speech runs on Interview Service only. Candidate Web sends a 16 kHz mono WAV
# recording and receives MP3 audio; it never receives provider credentials.
INTERVIEW_SPEECH_PROVIDER=google
INTERVIEW_SPEECH_MAX_AUDIO_BYTES=3145728
# Local: absolute path to the downloaded service-account JSON file.
# Render: upload it as a Secret File and use /etc/secrets/<filename>.json.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SPEECH_LANGUAGE=vi-VN
GOOGLE_TTS_LANGUAGE_CODE=vi-VN
# Optional. Leave empty to let Google choose a Vietnamese voice.
GOOGLE_TTS_VOICE=
# Azure remains available as an optional fallback when provider=azure.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=vi-VN
AZURE_SPEECH_VOICE=vi-VN-HoaiMyNeural
# Without SMTP settings, OTP is logged by the service for local development.
INTERVIEW_SMTP_HOST=
INTERVIEW_SMTP_PORT=587
INTERVIEW_SMTP_USERNAME=
INTERVIEW_SMTP_PASSWORD=
INTERVIEW_SMTP_FROM=no-reply@example.com
INTERVIEW_SMTP_FROM_NAME=AI Recruitment
INTERVIEW_SMTP_TIMEOUT_SECONDS=15
