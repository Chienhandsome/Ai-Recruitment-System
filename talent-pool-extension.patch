+'use client';
+
+import Link from 'next/link';
+import { useEffect, useRef, useState } from 'react';
+import {
+  ArrowLeft,
+  ArrowRight,
+  CheckCircle2,
+  Loader2,
+  LockKeyhole,
+  SearchX,
+  Wallet,
+} from 'lucide-react';
+import { toast } from 'sonner';
+import {
+  getMyEntitlement,
+  getTalentProfile,
+  unlockTalentProfile,
+  type EntitlementStatus,
+  type TalentPoolCard,
+} from '@/lib/billing-api';
+import type { RecruiterProfileData } from '@/lib/recruiter-api';
+import { RecruiterHeader } from '../RecruiterHeader';
+import { RecruiterProfileModal } from '../RecruiterProfileModal';
+import { TalentProfileContent } from './TalentProfileContent';
+
+const message = (error: unknown, fallback: string) =>
+  error instanceof Error ? error.message : fallback;
+
+/** Rebuild the list query from known keys only, safely re-encoded. */
+function sanitizeListQuery(raw: string) {
+  const parsed = new URLSearchParams(raw);
+  const out = new URLSearchParams();
+  for (const key of ['search', 'desiredTitle', 'skill', 'page']) {
+    const value = parsed.get(key);
+    if (value) out.set(key, value);
+  }
+  return out.toString();
+}
+
+export function TalentProfilePage({
+  token,
+  initialProfile,
+  candidateId,
+  listQuery,
+}: {
+  token: string;
+  initialProfile: RecruiterProfileData | null;
+  candidateId: string;
+  /** Encoded list filters/page captured when the recruiter opened this profile. */
+  listQuery: string;
+}) {
+  const [profile, setProfile] = useState(initialProfile);
+  const [showProfile, setShowProfile] = useState(false);
+  const [entitlement, setEntitlement] = useState<EntitlementStatus | null>(null);
+  const [candidate, setCandidate] = useState<TalentPoolCard | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [unlocking, setUnlocking] = useState(false);
+  const [quotaStale, setQuotaStale] = useState(false);
+  const unlockingRef = useRef(false);
+  const mounted = useRef(true);
+
+  const safeListQuery = sanitizeListQuery(listQuery);
+  const backHref = `/recruiter/talent-pool${safeListQuery ? `?${safeListQuery}` : ''}`;
+
+  useEffect(() => {
+    mounted.current = true;
+    const boot = async () => {
+      try {
+        const [status, full] = await Promise.all([
+          getMyEntitlement(token, 'EMPLOYER'),
+          getTalentProfile(token, candidateId),
+        ]);
+        if (!mounted.current) return;
+        setEntitlement(status);
+        setCandidate(full);
+      } catch (e) {
+        if (mounted.current) setError(message(e, 'Không tải được hồ sơ.'));
+      } finally {
+        if (mounted.current) setLoading(false);
+      }
+    };
+    void boot();
+    return () => {
+      mounted.current = false;
+    };
+  }, [token, candidateId]);
+
+  const retry = async () => {
+    setLoading(true);
+    setError(null);
+    try {
+      const full = await getTalentProfile(token, candidateId);
+      if (mounted.current) setCandidate(full);
+    } catch (e) {
+      if (mounted.current) {
+        // Drop any previously shown contact if access is no longer valid.
+        setCandidate(null);
+        setError(message(e, 'Không tải được hồ sơ. Ứng viên có thể đã ngừng chia sẻ.'));
+      }
+    } finally {
+      if (mounted.current) setLoading(false);
+    }
+  };
+
+  const unlock = async () => {
+    if (!candidate || unlockingRef.current || quotaStale) return;
+    if (!entitlement || entitlement.cvUnlockRemaining <= 0) return;
+    unlockingRef.current = true;
+    setUnlocking(true);
+    try {
+      const full = await unlockTalentProfile(token, candidate.id);
+      if (!mounted.current) return;
+      setCandidate(full);
+      toast.success('Đã mở thông tin liên hệ và CV. Xem lại hồ sơ này không mất thêm lượt.');
+      try {
+        const status = await getMyEntitlement(token, 'EMPLOYER');
+        if (mounted.current) {
+          setEntitlement(status);
+          setQuotaStale(false);
+        }
+      } catch {
+        if (mounted.current) setQuotaStale(true);
+      }
+    } catch (e) {
+      if (mounted.current) toast.error(message(e, 'Không thể mở liên hệ. Vui lòng thử lại.'));
+    } finally {
+      unlockingRef.current = false;
+      if (mounted.current) setUnlocking(false);
+    }
+  };
+
+  const canUnlock =
+    !!entitlement?.talentPoolAccess && entitlement.cvUnlockRemaining > 0 && !quotaStale;
+
+  return (
+    <div className="min-h-dvh bg-[#F8FAFC] text-[#1F2937]">
+      <RecruiterHeader
+        token={token}
+        profile={profile}
+        activeSection="talent-pool"
+        onOpenProfile={() => setShowProfile(true)}
+      />
+      <main className="mx-auto max-w-4xl space-y-5 px-4 py-6 sm:px-6">
+        <div className="flex flex-wrap items-center justify-between gap-3">
+          <Link
+            href={backHref}
+            className="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:border-blue-200 hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-blue-600"
+          >
+            <ArrowLeft className="size-3.5" />
+            Quay lại kho ứng viên
+          </Link>
+          {entitlement?.talentPoolAccess && (
+            <p className="text-xs text-slate-500">
+              Lượt mở liên hệ còn lại:{' '}
+              <strong className="text-blue-700">
+                {quotaStale ? '—' : entitlement.cvUnlockRemaining}
+              </strong>
+            </p>
+          )}
+        </div>
+
+        {loading ? (
+          <div
+            role="status"
+            aria-label="Đang tải hồ sơ"
+            className="rounded-2xl border border-slate-200 bg-white p-6 motion-safe:animate-pulse"
+          >
+            <div className="h-4 w-1/3 rounded bg-slate-100" />
+            <div className="mt-3 h-6 w-1/2 rounded bg-slate-100" />
+            <div className="mt-6 space-y-2">
+              <div className="h-3 rounded bg-slate-100" />
+              <div className="h-3 rounded bg-slate-100" />
+              <div className="h-3 w-2/3 rounded bg-slate-100" />
+            </div>
+          </div>
+        ) : entitlement && !entitlement.talentPoolAccess ? (
+          <section className="rounded-2xl border border-slate-200 bg-white px-6 py-14 text-center shadow-xs">
+            <span className="mx-auto flex size-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
+              <LockKeyhole className="size-6" />
+            </span>
+            <h1 className="mt-5 text-base font-extrabold text-slate-900">
+              Gói hiện tại chưa có quyền truy cập kho ứng viên
+            </h1>
+            <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
+              Xem các gói HR để tìm kiếm hồ sơ và mở thông tin liên hệ.
+            </p>
+            <Link
+              href="/recruiter/billing"
+              className="mt-6 inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-xs font-bold text-white hover:bg-blue-700"
+            >
+              Xem gói dịch vụ
+              <ArrowRight className="size-4" />
+            </Link>
+          </section>
+        ) : error || !candidate ? (
+          <section className="flex flex-col items-center rounded-2xl border border-slate-200 bg-white px-6 py-14 text-center shadow-xs">
+            <span className="flex size-14 items-center justify-center rounded-2xl border border-slate-100 bg-slate-50 text-slate-400">
+              <SearchX className="size-6" />
+            </span>
+            <h1 className="mt-5 text-base font-extrabold text-slate-900">
+              Không xem được hồ sơ này
+            </h1>
+            <p className="mt-2 max-w-md text-sm leading-6 text-slate-500">
+              {error ||
+                'Ứng viên có thể đã ngừng tìm việc hoặc hồ sơ không còn hiển thị trong kho ứng viên.'}
+            </p>
+            <Link
+              href={backHref}
+              className="mt-6 inline-flex items-center gap-2 rounded-xl border border-blue-200 bg-blue-50 px-4 py-2.5 text-xs font-bold text-blue-700 hover:bg-blue-100"
+            >
+              <ArrowLeft className="size-3.5" />
+              Quay lại kho ứng viên
+            </Link>
+          </section>
+        ) : (
+          <section className="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs sm:p-6">
+            <TalentProfileContent
+              candidate={candidate}
+              token={token}
+              loading={false}
+              error={null}
+              onRetry={() => void retry()}
+            />
+            <div className="mt-7 border-t border-slate-100 pt-5">
+              {candidate.contactUnlocked ? (
+                <p className="flex items-center justify-center gap-2 text-xs font-semibold text-emerald-700">
+                  <CheckCircle2 className="size-4" />
+                  Đã mở liên hệ · Xem lại không mất lượt
+                </p>
+              ) : (
+                <>
+                  <button
+                    type="button"
+                    onClick={() => void unlock()}
+                    disabled={!canUnlock || unlocking}
+                    className="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#2563EB] px-4 py-3 text-xs font-bold text-white hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500"
+                  >
+                    {unlocking ? (
+                      <Loader2 className="size-4 animate-spin" />
+                    ) : (
+                      <LockKeyhole className="size-4" />
+                    )}
+                    {unlocking ? 'Đang mở liên hệ...' : 'Mở liên hệ và CV · 1 lượt'}
+                  </button>
+                  {!canUnlock && (
+                    <p className="mt-2 flex items-center justify-center gap-1.5 text-center text-xs text-slate-600">
+                      <Wallet className="size-3.5" />
+                      {quotaStale
+                        ? 'Chưa cập nhật được hạn mức. Tải lại trang để tiếp tục.'
+                        : 'Bạn đã hết lượt mở liên hệ.'}{' '}
+                      <Link
+                        href="/recruiter/billing"
+                        className="font-semibold text-blue-700 underline"
+                      >
+                        Xem gói dịch vụ
+                      </Link>
+                    </p>
+                  )}
+                </>
+              )}
+            </div>
+          </section>
+        )}
+      </main>
+      <RecruiterProfileModal
+        isOpen={showProfile}
+        onClose={() => setShowProfile(false)}
+        profile={profile}
+        onProfileUpdated={setProfile}
+      />
+    </div>
+  );
+}
