+
+function safeWebLink(value: string) {
+  try {
+    const url = new URL(value);
+    return ['https:', 'http:'].includes(url.protocol) ? url.href : null;
+  } catch {
+    return null;
+  }
+}
+
+function month(value: string) {
+  const date = new Date(value);
+  return Number.isNaN(date.getTime())
+    ? ''
+    : date.toLocaleDateString('vi-VN', { month: '2-digit', year: 'numeric' });
+}
+
+/**
+ * Shared profile body used by both the quick-view drawer and the standalone
+ * profile page so recruiters always see the same information and actions.
+ */
+export function TalentProfileContent({
+  candidate,
+  token,
+  loading,
+  error,
+  onRetry,
