+    } finally {
+      setResumeBusy(false);
+    }
+  };
+
+  return (
+    <div className="space-y-7" aria-busy={loading}>
+      <section>
+        <div className="mb-3 inline-flex items-center gap-1.5 rounded-md bg-emerald-50 px-2 py-1 text-[11px] font-bold text-emerald-700">
+          <CheckCircle2 className="size-3.5" />
